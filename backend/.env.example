# Copia este archivo como .env (no se sube a git) y rellena los valores.

# --- Servidor ---
SERVER_PORT=8081
BACKEND_BASE_URL=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Opcional: por defecto FRONTEND_BASE_URL/oauth2/callback
# FRONTEND_OAUTH2_REDIRECT_URI=

# --- Base de datos (la misma configuración usa docker-compose.yml) ---
DB_URL=jdbc:mariadb://localhost:3306/gogaming
DB_DRIVER=org.mariadb.jdbc.Driver
DB_DATABASE=gogaming
DB_USER=gogaming
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Archivos ---
# Carpeta para las fotos de perfil (fuera de git)
UPLOAD_PATH=./uploads

# --- JWT (RS256 con un keystore; ver README para generarlo) ---
JWT_KEYSTORE_PATH=./storage/certs/jwt.jks
JWT_KEYSTORE_PASSWORD=
JWT_KEYSTORE_ALIAS=jwt-keypair

# --- Email (códigos 2FA y confirmación de pedidos). Gmail: contraseña de aplicación ---
MAIL_USERNAME=
PASSWORD_EMAIL_SMTP=

# --- Login con Google (Google Cloud Console → Credenciales → OAuth 2.0) ---
# URI de redirección autorizada: BACKEND_BASE_URL/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (modo test: claves sk_test_ / pk_test_) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Solo hace falta para el webhook (stripe listen --forward-to localhost:8081/api/v1/payments/webhook)
STRIPE_WEBHOOK_SECRET=

# --- Asistente con IA (OpenRouter, modelos gratuitos en orden de preferencia) ---
OPENROUTER_API_KEY=
# Opcional: por defecto la lista de ChatService. Si el chat deja de responder, revisa https://openrouter.ai/api/v1/models
# OPENROUTER_MODELS=
